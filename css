*{box-sizing: border-box}

:root{
    --accent:#6d28d9;
    --accent-l:#ede9fe;
    --bg:#f5f6fc;
    --text:#1e1b33;
    --muted:#6b7280;
    --border:#e8e8f2;
}

body{
    margin:0;
    font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
    color:var(--text);
    min-height:100vh;
    background:radial-gradient(1100px 550px at 5%, -10%, #ede9fe 0%, transparent 60),
    radial-gradient(900px 500px at 100%, 0%, #dbeafe 0%, transparent 55%),
    var(--bg);
    -webkit-text-size-adjust:100%;
}

h1,h2,h3{margin:0 0 8px}
h2{font-size:20px}
.muted{color:var(--muted)}
.small{font-size:13px}

/*----------Кнопки----------*/

.btn{
    border:none;border-radius:10px;padding:11px 18px;font-size:15px;
    font-weight:600;cursor:pointer;font-family:inherit;transition:15s;
    -webkit-tap-highlight-color:transparent;
    touch-action:manipulation;
}
.btn.primary{
    background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;
    box-shadow:0 8px 18px rgba(124,58,237,.30);
}
.btn.primary:hover{filter:brightness(1.08);transform:translateY(-1px)}
.btn.primary:active{transform:translateY(0)}
.btn.ghost{background:#fff;border:1px solid var(--border);color:var(--text)}
.btn.ghost:hover{background:#f6f6fb}
.btn.small{padding:6px 12px;font-size:13px;border-radius:8px;
}
.btn:disabled{opacity:5;cursor:not-allowed;box-shadow:none;transform:none;}

/*----------Поле вводу----------*/

input[type=text],
input[type=email],
input[type=password],
input[type=number],
select{
    width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:10px;
    font-size:16px;/*16px-Щоб IOS не зумив про фокусі*/

    font-family:inherit;background:#fbfbfe;
    color:inherit;
    outline:none;transition:15s;
    -webkit-appearance:none;
    appearance:none;
}
input:focus,select:focus{
    border-color:var(--accent);background:#fff;
    box-shadow:0 0 0 3px rgba(109,40,217,.13);
}
input[type=checkbox]{
    width:18px;height:18px;accent-color:var(--accent);
    cursor:pointer;flex:none;
}
label.field{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:600;color:var(--muted)}
label.field.grow{flex:1;min-width:180px}

/*----------Авторизація----------*/

.auth-wrap{min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:24px}
.auth-card{width:100%;max-width:420px;padding:32px;text-align:center}
.brand{
    font-size:26px;font-weight:800;letter-spacing:-.5px;
    background:linear-gradient(135deg,#7c3aed,#a855f7);
    -webkit-background-clip:text;background-clip:text;color:transparent;
}
.auth-card .brand{margin-bottom:4px}
.tabs{display:flex;gap:6px;background:#f1f1f8;padding:5px;border-radius:12px;margin:20px 0 18px}
.tab{
    flex:1;border:none;background:transparent;padding:10px;border-radius:9px;
    font-family:inherit;font-size:14px;font-weight:600;color:var(--muted);
    cursor:pointer;transition:.15s;-webkit-tap-highlight-color:transparent;
}

.tab.active{background:#fff;color:var(--accent);box-shadow:0 2px 8px rgba(0,0,0,.07)}
form{display:flex;flex-direction:column;gap:14px;text-align:left}
.error{
    background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;
    padding:10px 12px;border-radius:10px;font-size:13px;
}
.notice{
    background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;
    padding:10px 12px;border-radius:10px;font-size:13px;text-align:left;margin-top:14px;
}

/*----------Карточки----------*/
.card{
    background:#fff;border:1px solid var(--border);border-radius:18px;
    padding:22px;box-shadow:0 10px 30px rgba(30,27,51,.05);
}
.container{
    max-width:900px;margin:0 auto;padding:24px 20px 60px;
    padding-bottom:calc(60px+env(safe-area-inset-bottom));
    display:flex;flex-direction:column;gap:2 0px;
}

/*----------Шапка----------*/
.topbar{
    background:rgba(255,255,255,.85);backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
    position:sticky;top:0;z-index:10;
    padding-top:env(safe-area-inset-top);
}
.topbar-inner{
    max-width:900px;margin:0 auto;padding:14px 20px;
    display:flex;align-items:center;justify-content:space-between;
    gap:12px;flex-wrap:wrap;
}
.userbox{display:flex;align-items:center;gap:12px;font-weight:600;font-size:14px}
.badge{
    font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;
    padding:4px 9px;border-radius:999px;
}
.badge.teacher{background:#ede9fe;color:#6d28d9}
.badge.student{background:#dbeafe;color:#1d4ed8}

/*----------Статистика----------*/
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(15px,1fr));gap:14px}
.stat{
    background:#fff;border:1px solid var(--border);border-radius:16px;padding:18px;
    box-shadow:0 8px 24px rgba(30,27,51,.04);
}
.stat-val{font-size:28px;font-weight:800;color:var(--accent);line-height:1.1}
.stat-lbl{font-size:13px;color:var(--muted);margin-top:4px}

/*----------Керування Нарахуванням----------*/
.controls{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin: 16px 0 18px}
.controls .btn{height:44px}
.list-head{
    display:flex;justify-content:space-between;align-items:center;
    padding: 10px 4px;border-top:1px solid var(--border);
}
.check-all{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;cursor:pointer}

/*----------Рядок Учня----------*/
.row{
    display:flex;align-items:center;gap:12px;padding:12px;
    border:1px solid var(--border);border-radius:14px;background:#fff;
    margin-bottom:8px;transition:.15s;
}
.row:hover{background:#fafaff;border-color:#ddd8f5}
.row.picked{background:#f7f4ff;border-color:#c4b5fd}
.avatar{
    width:40px;height:40px;border-radius:5 0%;flex:none;
    background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;
    display:grid;place-items:center;font-weight:700;font-size:16px;
}
.row.info{flex:1;min-width:0}
.row.name{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.coins{font-weight:700;color:#b45309;white-space:nowrap;font-size:15px}
.empty{padding:32px;text-align:center;color:var(--muted);font-size:14px}

/*----------Сторінка Учня----------*/
.hero{
    background:linear-gradient(135deg,#7c3aed,#a855f7);
    color:#fff;border-radius:20px;padding:32px;
    box-shadow:0 16px 40px rgba(124,58,237,.32);
}
.hero-lbl{font-size:14px;opacity:.85;font-weight:600;letter-spacing:.4px}
.hero-val{font-size:56px;font-weight:800;line-height:1.1;margin:6px 0}
.hero-sub{font-size:14px;opacity:.9}
.txt{
    display:flex;align-items:center;gap:14px;padding:14px 4px;
    border-bottom:1px solid var(--border);
}
.tx:last-child{border-bottom:none}
.tx-plus{
    font-weight:800;color:#16a34a;font-size:17px;
    background:#f0fdf4;border-radius:10px;padding:8px 14px;flex:none;
}

/*----------Тост----------*/
#toast{
    position:fixed;left:50%;bottom:28px;
    bottom:calc(28px + env(safe-area-inset-bottom));
    transform:translate(-50%,120%);
    background:#1e1b33;color:#fff;padding:13px 22px;border-radius:12px;
    font-size:14px;font-weight:600;z-index:100;
    box-shadow:0 12px 30px rgba(0,0,0,.28);
    transition:transform .3s cubic-bezier(.2,.8,.3,1.2);pointer-events:none;max-width:90vw;text-align:center;
}
#toast.show{transform:translate(-50%,0)}
#toast.ok{background:#15803d}
#toast.err{background:#b91c1c}

